{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ipg-output.schema.json",
  "title": "IPG output v1",
  "type": "object",
  "required": ["schema", "releaseId", "versions", "scope", "publishable", "candidate", "versionNotes", "displayValues", "sections", "publicationAnnotations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ipg-output-v1"},
    "releaseId": {"type": "string"},
    "versions": {
      "type": "object",
      "required": ["official", "annotations", "translation"],
      "properties": {
        "official": {"type": "object", "required": ["effectiveDate", "pdfSha256"]},
        "annotations": {"type": "object", "required": ["version", "sourceSha256"]},
        "translation": {"type": "object", "required": ["locale", "revision"]}
      }
    },
    "scope": {
      "type": "object",
      "required": ["officialContent", "publicationAnnotations"],
      "properties": {
        "officialContent": {"type": "object", "required": ["mode"]},
        "publicationAnnotations": {"type": "object", "required": ["mode"]}
      }
    },
    "publishable": {"type": "boolean", "description": "Recorded public-publication intent, copied without promotion. Not a local-build gate or proof of permission."},
    "candidate": {"type": "boolean"},
    "versionNotes": {
      "type": "object",
      "required": ["id", "en", "zh"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "ipg-version-notes"},
        "en": {"const": ""},
        "zh": {"type": "string", "pattern": "^# 版本说明\\n", "not": {"pattern": "(?m)^# 目录\\s*$"}}
      }
    },
    "displayValues": {
      "type": "object",
      "additionalProperties": {"$ref": "https://example.invalid/ipg-source.schema.json#/$defs/localized"}
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://example.invalid/ipg-source.schema.json#/$defs/section"}
    },
    "publicationAnnotations": {
      "type": "array",
      "items": {"$ref": "https://example.invalid/ipg-source.schema.json#/$defs/annotation"}
    }
  }
}

