{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "baseReleaseId", "targetOfficial", "mappings"],
  "properties": {
    "schemaVersion": {"const": 1}, "baseReleaseId": {"type": "string"},
    "targetOfficial": {"type": "object", "additionalProperties": false, "required": ["effectiveDate", "pdfSha256"],
      "properties": {"effectiveDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "pdfSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "mappings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["operation", "kind", "fromIds", "toExtractionIds", "sourceHashes", "targetHashes", "reason"],
      "properties": {
        "operation": {"enum": ["continue", "rename", "renumber", "move", "split", "merge"]},
        "kind": {"enum": ["section", "component", "group", "block"]},
        "fromIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ipg-"}},
        "toExtractionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^extract-"}},
        "sourceHashes": {"$ref": "#/$defs/hashes"}, "targetHashes": {"$ref": "#/$defs/hashes"},
        "preserveId": {"type": ["string", "null"]}, "preserveExtractionId": {"type": "string"},
        "reason": {"type": "string", "minLength": 1}
      }}}
  },
  "$defs": {"hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
}
